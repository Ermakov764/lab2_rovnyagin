# =============================================================================
# Персональная ВМ (hl03) + БД на общей ВМ hl12 (Docker Compose lab8-hl12).
# Файл в .gitignore — не коммитить.
#
# Запуск:
#   docker compose -f docker-compose.hl12.yml --env-file .env up -d --force-recreate
# =============================================================================

# --- Образы ---
# CRUD: docker build -t lavrentiyermakov/lab2_rovnyagin:local .
# Additional: docker build -f Dockerfile.additional-service -t lavrentiyermakov/lab2_additional:local .
# Hub :latest для Additional часто БЕЗ GET /api/analytics/films/max-viewers-summary → 404 и 500 у прокси на 8080.
# Пуш на свой Hub (после docker login): docker tag ... && docker push ...
DOCKER_IMAGE_APP=lavrentiyermakov/lab2_rovnyagin:latest
DOCKER_IMAGE_ADDITIONAL=lavrentiyermakov/lab2_additional:lab8-20260503

# --- PostgreSQL на hl12 (сеть 10.60.3.x) ---
# На hl12 контейнер проброшен как 0.0.0.0:5433 -> 5432, поэтому с hl03 используем порт 5433.
DBHOST=10.60.3.9
DBPORT=5433
DBNAME=hl3
# На hl12 в БД hl3 есть схемы hl3 и public (\dn); в application.properties для курса — SCHEMANAME=hl3 (Flyway/JPA).
SCHEMANAME=hl3

SPRING_DATASOURCE_USERNAME=postgres
# Курс: в таблице для psql — пароль hl_postgres (не путать с pgAdmin hl_labs).
SPRING_DATASOURCE_PASSWORD=hl_postgres

# Compose сам подставит SPRING_DATASOURCE_URL из DBHOST/DBPORT/DBNAME/SCHEMANAME (строка ниже не влияет на контейнер, только для справки):
# jdbc:postgresql://10.60.3.9:5433/hl3?currentSchema=hl3

# --- Справка / pgAdmin (локальный Postgres не поднимаем; значения должны совпадать с hl12) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hl_postgres
POSTGRES_DB=hl3

# --- Spring в контейнере crud-app ---
# Меньше потоков — меньше одновременных тяжёлых запросов к БД при ограниченном heap/Hikari.
SERVER_TOMCAT_THREADS_MAX=80
# Heap в пределах APP_MEMORY_LIMIT (оставь запас под metaspace / direct memory).
# Целиком в кавычках: иначе .env/env-file часто передаёт только первый токен и JVM падает при старте.
JAVA_TOOL_OPTIONS="-Xms256m -Xmx1152m"
# Additional (лаб. 8): при OOM в микросервисе увеличь лимит памяти и при необходимости:
# ADDITIONAL_JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# --- Порты на hl03 (при конфликте с соседями — смени) ---
APP_PUBLISH_PORT=8080
ADDITIONAL_PUBLISH_PORT=8081

# --- Лимиты (лаб. 6/8, эксперименты) ---
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=1536M
APP_CPU_RESERVATION=0.25
APP_MEMORY_RESERVATION=256M

ADDITIONAL_CPU_LIMIT=1.0
ADDITIONAL_MEMORY_LIMIT=512M
ADDITIONAL_CPU_RESERVATION=0.1
ADDITIONAL_MEMORY_RESERVATION=128M

# Внутри compose-сети (по умолчанию не трогать):
# ADDITIONAL_SERVICE_BASE_URL=http://additional-app:8081
MAIN_CRUD_BASE_URL=http://crud-app:8080
KAFKA_LISTENER_CONCURRENCY=1