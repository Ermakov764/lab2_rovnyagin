# Скопируйте в .env и подставьте свои значения (файл .env не коммитится).
#
# --- Docker Compose: CRUD + Additional + локальный Postgres (сервис postgresdb) ---
# На ВМ приложений:
#   docker compose --env-file .env up -d
# CRUD :8080 (lab2_crud_app), Additional :8081 (lab2_additional_app), Postgres lab2_postgres.
#
# POSTGRES_DB и DBNAME для локального стека должны совпадать (часто lab2_db / public).
# Если порт 5432 на хосте занят (например lab8_postgres): POSTGRES_PUBLISH_PORT=5433 — с хоста psql на :5433,
# в контейнере crud-app по-прежнему DBHOST=postgresdb DBPORT=5432.
#
# Внешняя БД (нет прав на общий сервер / своя hl12): удалите сервис postgresdb и volume postgres_data
# из docker-compose.yml или используйте отдельный compose-файл; задайте DBHOST на IP/DNS, доступный с ВМ приложений.

# Имя образа на Docker Hub (ТЗ: токен, docker login).
# docker compose pull crud-app additional-app && docker compose --env-file .env up -d
# Сборка: docker build -t "$DOCKER_IMAGE_APP" . && docker push "$DOCKER_IMAGE_APP"
# Additional: Dockerfile.additional-service → DOCKER_IMAGE_ADDITIONAL
DOCKER_IMAGE_APP=lavrentiyermakov/lab2_rovnyagin:latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab2_password
POSTGRES_DB=lab2_db

# С локальным postgresdb в compose:
DBHOST=postgresdb
DBPORT=5432
DBNAME=lab2_db
SCHEMANAME=public

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=lab2_password

SERVER_TOMCAT_THREADS_MAX=200
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Пул JDBC (лаб. 8: Additional ходит в CRUD; под k6 при ~50 VU разумно 60+ при возможностях Postgres).
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=60

# Additional → CRUD (RestTemplate), мс.
MAIN_CRUD_HTTP_CONNECT_TIMEOUT_MS=120000
MAIN_CRUD_HTTP_READ_TIMEOUT_MS=180000

# Проверка: docker inspect lab2_crud_app --format '{{.HostConfig.NanoCpus}} {{.HostConfig.Memory}}'
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=1536M

DOCKER_IMAGE_ADDITIONAL=lavrentiyermakov/lab2_additional:latest
ADDITIONAL_CPU_LIMIT=1.0
ADDITIONAL_MEMORY_LIMIT=2048M
ADDITIONAL_PUBLISH_PORT=8081
APP_PUBLISH_PORT=8080
ADDITIONAL_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=55
# POSTGRES_PUBLISH_PORT=5433
# MAIN_CRUD_BASE_URL=http://crud-app:8080
# ADDITIONAL_SERVICE_BASE_URL=http://additional-app:8081
