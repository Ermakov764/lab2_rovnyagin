# Скопируйте в .env (файл не коммитится). ТЗ: одна общая PostgreSQL на узле БД (hl12 / таблица курса).
#
# На ВМ приложений:
#   docker compose pull crud-app additional-app && docker compose --env-file .env up -d
# CRUD :8080 (lab2_crud_app), Additional :8081 (lab2_additional_app). Локального Postgres в compose нет.
#
# DBHOST — хост или IP узла БД, доступный ИЗ контейнера crud-app (см. таблицу выделенных ресурсов).
# DBNAME / SCHEMANAME — как у преподавателя (пример: hl3).
#
# Проверка с ВМ приложений: nc -vz $DBHOST $DBPORT
# Если refused, а на hl12 postgres слушает только 127.0.0.1 — нужна настройка сервера БД под доступ из подсети курса (не со стороны этого репозитория).

DOCKER_IMAGE_APP=lavrentiyermakov/lab2_rovnyagin:latest
DOCKER_IMAGE_ADDITIONAL=lavrentiyermakov/lab2_additional:latest

DBHOST=hl12.zil
DBPORT=5432
DBNAME=hl3
SCHEMANAME=hl3

# Либо одной строкой (перекрывает сборку URL из полей выше):
# SPRING_DATASOURCE_URL=jdbc:postgresql://hl12.zil:5432/hl3?currentSchema=hl3

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=замените_по_таблице_курса

SERVER_TOMCAT_THREADS_MAX=200
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=60

MAIN_CRUD_HTTP_CONNECT_TIMEOUT_MS=120000
MAIN_CRUD_HTTP_READ_TIMEOUT_MS=180000

APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=1536M
ADDITIONAL_CPU_LIMIT=0.5
ADDITIONAL_MEMORY_LIMIT=2048M
ADDITIONAL_PUBLISH_PORT=8081
APP_PUBLISH_PORT=8080
ADDITIONAL_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=55
