# Скопируйте в .env и подставьте свои значения (файл .env не коммитится).
#
# --- Docker Compose: только CRUD + Additional; PostgreSQL на отдельной машине ---
# На ВМ приложений:
#   docker compose --env-file .env up -d
# CRUD :8080 (lab2_crud_app), Additional :8081 (lab2_additional_app).
# Обязательно задайте доступ к вашей БД: DBHOST, DBPORT, DBNAME, SCHEMANAME, учётные данные.
# Имя БД из таблицы курса (пример): DBNAME=hl3, SCHEMANAME=hl3 или public — как в методичке.
#
# POSTGRES_* ниже — для справки / сидов на стороне БД; контейнер Postgres в этом репозитории не поднимается.

# Имя образа на Docker Hub (ТЗ: токен, docker login).
# docker compose pull crud-app additional-app && docker compose --env-file .env up -d
# Сборка: docker build -t "$DOCKER_IMAGE_APP" . && docker push "$DOCKER_IMAGE_APP"
# Additional: Dockerfile.additional-service → DOCKER_IMAGE_ADDITIONAL
DOCKER_IMAGE_APP=lavrentiyermakov/lab2_rovnyagin:latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab2_password
POSTGRES_DB=lab2_db

# Хост и порт БД — с точки зрения контейнера crud-app (IP сервера БД или DNS, проброшенный порт).
DBHOST=10.60.3.9
DBPORT=5432
DBNAME=lab2_db
SCHEMANAME=public

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=lab2_password

SERVER_TOMCAT_THREADS_MAX=200
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Пул JDBC (лаб. 8: Additional ходит в CRUD; при дефолтных 10 соединениях легко упираются в Hikari под k6).
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=40

# Лимиты CPU/RAM (compose: cpus / mem_limit у crud-app; лаб. 6/8 — серия точек, обычно 0.5 и 1.0 vCPU).
# Проверка: docker inspect lab2_crud_app --format '{{.HostConfig.NanoCpus}} {{.HostConfig.Memory}}'
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=1536M

# Опционально (в данном docker-compose не используются — только cpus/mem_limit):
# APP_CPU_RESERVATION=0.25
# APP_MEMORY_RESERVATION=256M

DOCKER_IMAGE_ADDITIONAL=lavrentiyermakov/lab2_additional:latest
ADDITIONAL_CPU_LIMIT=1.0
ADDITIONAL_MEMORY_LIMIT=2048M
ADDITIONAL_PUBLISH_PORT=8081
APP_PUBLISH_PORT=8080
ADDITIONAL_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=55
# MAIN_CRUD_BASE_URL=http://crud-app:8080
# ADDITIONAL_SERVICE_BASE_URL=http://additional-app:8081
