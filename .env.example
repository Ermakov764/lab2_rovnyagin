# Скопируйте в .env и подставьте свои значения (файл .env не коммитится).
#
# --- Docker Compose: только CRUD + Additional; PostgreSQL на отдельной машине (ТЗ) ---
# На ВМ приложений:
#   docker compose pull crud-app additional-app && docker compose --env-file .env up -d
# CRUD :8080 (lab2_crud_app), Additional :8081 (lab2_additional_app).
# В этом репозитории контейнер Postgres не поднимается — только приложения; БД вы настраиваете на узле курса.
#
# Обязательно: DBHOST, DBPORT, DBNAME, SCHEMANAME, учётные данные JDBC — по таблице/методичке.
# Пример из курса: DBNAME=hl3, SCHEMANAME=hl3; другой вариант: lab2_db / public.
# Хост DBHOST — IP или DNS, который ДОСТУПЕН ИЗ контейнера crud-app (проверка на ВМ приложений):
#   nc -vz "$DBHOST" "$DBPORT"
#
# POSTGRES_* ниже — для справки (сидеры, pgAdmin, документация к узлу БД). Docker Compose эти имена
# в текущем docker-compose.yml для сервиса приложения не подставляет — реально смотрит на DBNAME,
# SPRING_DATASOURCE_* и при необходимости SPRING_DATASOURCE_URL.

# Имя образа на Docker Hub (ТЗ: токен, docker login).
# Сборка CRUD: docker build -t "$DOCKER_IMAGE_APP" . && docker push "$DOCKER_IMAGE_APP"
# Сборка Additional: Dockerfile.additional-service → DOCKER_IMAGE_ADDITIONAL
DOCKER_IMAGE_APP=lavrentiyermakov/lab2_rovnyagin:latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab2_password
POSTGRES_DB=lab2_db

# Хост и порт БД — с точки зрения контейнера crud-app (IP узла БД из таблицы курса или DNS, например hl12.zil).
DBHOST=10.60.3.9
DBPORT=5432
DBNAME=lab2_db
SCHEMANAME=public

# Явный JDBC (необязательно): если задан, docker-compose передаёт его в CRUD как есть
# (удобно, когда имя БД/схема не совпадают с дефолтной сборкой из полей выше).
# SPRING_DATASOURCE_URL=jdbc:postgresql://10.60.3.9:5432/lab2_db?currentSchema=public

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=lab2_password

SERVER_TOMCAT_THREADS_MAX=200
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Пул Hikari у CRUD; при нагрузке k6 дефолт 10 мало — типично 40–60 (не больше max_connections на Postgres).
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=40

# Additional → CRUD (RestTemplate), миллисекунды
MAIN_CRUD_HTTP_CONNECT_TIMEOUT_MS=120000
MAIN_CRUD_HTTP_READ_TIMEOUT_MS=180000

# Лимиты CPU/RAM (compose: cpus / mem_limit у crud-app и additional-app; лаб. 6/8 — серия точек, например 0.5 и 1.0 vCPU).
# Проверка: docker inspect lab2_crud_app --format '{{.HostConfig.NanoCpus}} {{.HostConfig.Memory}}'
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=1536M

# Опционально (в данном docker-compose не пробрасываются — только cpus/mem_limit):
# APP_CPU_RESERVATION=0.25
# APP_MEMORY_RESERVATION=256M

DOCKER_IMAGE_ADDITIONAL=lavrentiyermakov/lab2_additional:latest
ADDITIONAL_CPU_LIMIT=1.0
ADDITIONAL_MEMORY_LIMIT=2048M
ADDITIONAL_PUBLISH_PORT=8081
APP_PUBLISH_PORT=8080
ADDITIONAL_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=55

# Имена сервисов внутри docker-сети (менять не нужно, если не меняли имена в compose).
MAIN_CRUD_BASE_URL=http://crud-app:8080
ADDITIONAL_SERVICE_BASE_URL=http://additional-app:8081
