# Шаблон: скопируйте в 03-secret-db.yaml (не коммитьте с паролем) или создайте через kubectl:
#
#   kubectl -n hl3 create secret generic lab2-db-credentials \
#     --from-literal=SPRING_DATASOURCE_PASSWORD='ВАШ_ПАРОЛЬ_POSTGRES'
#
# Ключ SPRING_DATASOURCE_PASSWORD должен совпадать с deployment-main.
apiVersion: v1
kind: Secret
metadata:
  name: lab2-db-credentials
  namespace: hl3
type: Opaque
stringData:
  SPRING_DATASOURCE_PASSWORD: "REPLACE_ME"
